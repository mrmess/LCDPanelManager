<UserControl x:Class="LCDPanelManager.Views.DiagnosticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="28,22,28,20">
    <Grid.ColumnDefinitions>
      <ColumnDefinition />
      <ColumnDefinition Width="16" />
      <ColumnDefinition Width="420" />
    </Grid.ColumnDefinitions>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,14,0">
      <StackPanel>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="Device lock" Style="{StaticResource CardTitle}" />
            <TextBlock x:Name="LockRules" Style="{StaticResource Dim}" TextWrapping="Wrap" LineHeight="20" Margin="0,8,0,0" />
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
          <StackPanel>
            <Grid>
              <TextBlock Text="Serial ports" Style="{StaticResource CardTitle}" VerticalAlignment="Center" />
              <Button x:Name="RescanButton" Style="{StaticResource BaseButton}" Content="Rescan" Padding="14,5" HorizontalAlignment="Right"
                      ToolTip="Reads the Windows device registry. Does not open any port." />
            </Grid>
            <Grid Margin="0,14,0,6">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70" />
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="90" />
                <ColumnDefinition />
              </Grid.ColumnDefinitions>
              <TextBlock Text="PORT" Style="{StaticResource Caps}" />
              <TextBlock Grid.Column="1" Text="USB ID" Style="{StaticResource Caps}" />
              <TextBlock Grid.Column="2" Text="VERDICT" Style="{StaticResource Caps}" />
              <TextBlock Grid.Column="3" Text="WHY" Style="{StaticResource Caps}" />
            </Grid>
            <StackPanel x:Name="PortRows" />
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
          <StackPanel>
            <TextBlock Text="Protocol reference" Style="{StaticResource CardTitle}" />
            <TextBlock x:Name="ProtocolText" Style="{StaticResource Dim}" TextWrapping="Wrap" LineHeight="20" Margin="0,8,0,10"
                       FontFamily="Cascadia Mono, Consolas" FontSize="11" />
            <StackPanel Orientation="Horizontal">
              <Button x:Name="SelfTestButton" Style="{StaticResource BaseButton}" Content="Build test frames in memory" Padding="14,5"
                      ToolTip="Builds frames as byte arrays and shows them here. Nothing is sent." />
            </StackPanel>
            <TextBlock x:Name="SelfTestOut" Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,10,0,0"
                       FontFamily="Cascadia Mono, Consolas" FontSize="11" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <DockPanel Grid.Column="2">
      <Border DockPanel.Dock="Top" Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="Link" Style="{StaticResource CardTitle}" />
          <Grid x:Name="LinkGrid" Margin="0,10,0,0" />
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}" Margin="0,12,0,0">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="Event log" Style="{StaticResource CardTitle}" Margin="0,0,0,8" />
          <ListBox x:Name="LogList" Style="{StaticResource DarkList}" FontFamily="Cascadia Mono, Consolas" FontSize="11" />
        </DockPanel>
      </Border>
    </DockPanel>
  </Grid>
</UserControl>

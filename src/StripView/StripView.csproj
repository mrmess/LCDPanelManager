<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>StripView</RootNamespace>
    <AssemblyName>StripView</AssemblyName>
    <Product>StripView</Product>
    <AssemblyTitle>StripView</AssemblyTitle>
    <Description>Offline companion for a 440x1920 USB case LCD strip. No network.</Description>
    <Version>0.1.0</Version>
    <ApplicationIcon>assets\stripview.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="assets\stripview.ico" />
  </ItemGroup>
</Project>

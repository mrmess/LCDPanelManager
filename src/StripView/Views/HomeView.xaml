<UserControl x:Class="StripView.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:StripView.Controls">
  <Grid Margin="28,22,28,20">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="300" />
      <ColumnDefinition Width="24" />
      <ColumnDefinition Width="320" />
      <ColumnDefinition Width="24" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- Left: active scene, send modes, quick scenes -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,14,0">
      <StackPanel>
        <TextBlock Text="ACTIVE SCENE" Style="{StaticResource Caps}" />
        <TextBlock x:Name="SceneTitle" Text="Aurora Dashboard" FontSize="36" FontWeight="Bold" TextWrapping="Wrap"
                   LineHeight="40" Margin="0,8,0,0" FontFamily="Segoe UI Variable Display, Segoe UI" />
        <TextBlock x:Name="SceneBlurb" Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,10,0,0" LineHeight="18" />
        <Border Style="{StaticResource Chip}" HorizontalAlignment="Left" Margin="0,16,0,0">
          <TextBlock x:Name="WidgetCount" Text="0 LIVE WIDGETS" Style="{StaticResource Caps}" Foreground="{StaticResource TextPrimary}" />
        </Border>

        <Button x:Name="PauseButton" Style="{StaticResource LimeButton}" Margin="0,24,0,0">
          <Grid>
            <TextBlock x:Name="PauseLabel" Text="❚❚   Pause stream" FontWeight="SemiBold" />
            <TextBlock Text="SPACE" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="9" FontWeight="Bold" Opacity="0.65" />
          </Grid>
        </Button>
        <Button x:Name="PushButton" Style="{StaticResource OutlineButton}" Margin="0,8,0,0"
                ToolTip="Sends one full frame to the panel now.">
          <Grid>
            <TextBlock Text="↗   Push once" FontWeight="SemiBold" />
            <TextBlock Text="CTRL + P" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="9" FontWeight="Bold" Opacity="0.55" />
          </Grid>
        </Button>
        <Grid Margin="0,12,0,0">
          <TextBlock Text="Refresh cadence" Style="{StaticResource Dim}" FontSize="11" />
          <Button x:Name="CadenceButton" Style="{StaticResource LinkButton}" HorizontalAlignment="Right"
                  Content="Every 2 seconds" ToolTip="Click to cycle 2 / 3 / 5 seconds" />
        </Grid>
        <Grid Margin="0,8,0,0">
          <TextBlock x:Name="SendNote" Style="{StaticResource Dim}" FontSize="11" Foreground="{StaticResource TextFaint}"
                     TextWrapping="Wrap" Margin="0,0,90,0" VerticalAlignment="Center" />
          <Button x:Name="ConnectButton" Style="{StaticResource BaseButton}" Content="Connect" Padding="12,4" FontSize="11"
                  HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>

        <Grid Margin="0,34,0,10">
          <TextBlock Text="QUICK SCENES" Style="{StaticResource Caps}" />
          <Button x:Name="ViewAllButton" Style="{StaticResource LinkButton}" HorizontalAlignment="Right"
                  Foreground="{StaticResource Lime}" Content="Edit in Design →" />
        </Grid>
        <StackPanel x:Name="SceneList" />
      </StackPanel>
    </ScrollViewer>

    <!-- Center: the strip at its real aspect -->
    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18,16">
      <DockPanel>
        <Grid DockPanel.Dock="Top">
          <TextBlock Text="PANEL 01" Style="{StaticResource Caps}" />
          <TextBlock x:Name="PanelPort" Text="COM3" Style="{StaticResource Caps}" HorizontalAlignment="Right" />
        </Grid>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
          <TextBlock Text="Actual output · 440 × 1920" HorizontalAlignment="Center" FontSize="12" />
          <TextBlock Text="Aspect preserved. No guesswork." Style="{StaticResource Dim}" FontSize="11" HorizontalAlignment="Center" />
        </StackPanel>
        <Border Margin="0,14,0,0" Background="#050506" BorderBrush="#2C2F36" BorderThickness="2"
                CornerRadius="22" Padding="8" HorizontalAlignment="Center">
          <c:StripCanvas x:Name="Strip" />
        </Border>
      </DockPanel>
    </Border>

    <!-- Right: live telemetry desk -->
    <ScrollViewer Grid.Column="4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,14,0">
      <StackPanel>
        <Grid Margin="0,0,0,12">
          <TextBlock Text="Live telemetry" FontSize="18" FontWeight="SemiBold" />
          <TextBlock x:Name="SensorCount" Style="{StaticResource Caps}" HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>

        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="12" />
            <ColumnDefinition />
          </Grid.ColumnDefinitions>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="PROCESSOR" Style="{StaticResource Caps}" />
              <Grid Margin="0,14,0,4">
                <Grid HorizontalAlignment="Left" Width="118" Height="118">
                  <c:RingGauge x:Name="CpuRing" Thickness="11" ArcBrush="{StaticResource Lime}" TrackBrush="#2A2C31" />
                  <TextBlock x:Name="CpuValue" Text="0%" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
                <StackPanel Margin="140,0,0,0" VerticalAlignment="Center">
                  <TextBlock x:Name="CpuTemp" Text="—" FontSize="24" FontWeight="Bold" />
                  <TextBlock Text="CPU TEMP / C" Style="{StaticResource Caps}" Margin="0,2,0,6" />
                  <TextBlock x:Name="CpuTrend" FontSize="11" Foreground="{StaticResource Lime}" />
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>
          <Border Grid.Column="2" Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="GRAPHICS" Style="{StaticResource Caps}" />
              <Grid Margin="0,14,0,4">
                <Grid HorizontalAlignment="Left" Width="118" Height="118">
                  <c:RingGauge x:Name="GpuRing" Thickness="11" ArcBrush="{StaticResource Orange}" TrackBrush="#2A2C31" />
                  <TextBlock x:Name="GpuValue" Text="0%" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
                <StackPanel Margin="140,0,0,0" VerticalAlignment="Center">
                  <TextBlock x:Name="GpuTemp" Text="—" FontSize="24" FontWeight="Bold" />
                  <TextBlock Text="GPU TEMP / C" Style="{StaticResource Caps}" Margin="0,2,0,6" />
                  <TextBlock x:Name="GpuSourceLabel" Text="Live sensor" FontSize="11" Foreground="{StaticResource Orange}" />
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>
        </Grid>

        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
          <StackPanel>
            <Grid>
              <TextBlock Text="MEMORY" Style="{StaticResource Caps}" VerticalAlignment="Center" />
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock x:Name="MemValue" Text="0%" FontSize="22" FontWeight="Bold" />
                <TextBlock x:Name="MemDetail" Style="{StaticResource Dim}" VerticalAlignment="Bottom" Margin="6,0,0,3" />
              </StackPanel>
            </Grid>
            <c:Bar x:Name="MemBar" Height="6" Fill="{StaticResource Purple}" Margin="0,12,0,6" />
            <Grid>
              <TextBlock Text="0 GB" Style="{StaticResource Dim}" FontSize="10" />
              <TextBlock x:Name="MemTotal" Style="{StaticResource Dim}" FontSize="10" HorizontalAlignment="Right" />
            </Grid>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
          <StackPanel>
            <Grid>
              <TextBlock x:Name="NetTitle" Text="NETWORK" Style="{StaticResource Caps}" />
              <TextBlock Text="LIVE" Style="{StaticResource Caps}" HorizontalAlignment="Right" />
            </Grid>
            <Grid Margin="0,12,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="DOWNLOAD" Style="{StaticResource Caps}" />
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                  <TextBlock x:Name="DownValue" Text="0" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Cyan}" />
                  <TextBlock Text=" Mb/s" Style="{StaticResource Dim}" VerticalAlignment="Bottom" Margin="0,0,0,3" />
                </StackPanel>
              </StackPanel>
              <StackPanel Grid.Column="1">
                <TextBlock Text="UPLOAD" Style="{StaticResource Caps}" />
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                  <TextBlock x:Name="UpValue" Text="0" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Orange}" />
                  <TextBlock Text=" Mb/s" Style="{StaticResource Dim}" VerticalAlignment="Bottom" Margin="0,0,0,3" />
                </StackPanel>
              </StackPanel>
            </Grid>
            <c:Sparkline x:Name="NetSpark" Height="56" Margin="0,12,0,0" BrushA="{StaticResource Cyan}" BrushB="{StaticResource Orange}" />
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
          <StackPanel>
            <Grid>
              <TextBlock Text="STORAGE" Style="{StaticResource Caps}" />
              <TextBlock x:Name="DriveCount" Style="{StaticResource Caps}" HorizontalAlignment="Right" />
            </Grid>
            <StackPanel x:Name="DriveList" Margin="0,10,0,0" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>

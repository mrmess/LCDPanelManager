<UserControl x:Class="StripView.Views.DesignView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:StripView.Controls">
  <Grid Margin="28,22,28,20">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="300" />
      <ColumnDefinition Width="20" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- Left: the editable strip -->
    <Border Background="#0F1013" BorderBrush="#2C2F36" BorderThickness="1" CornerRadius="14" Padding="12">
      <DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Border Background="{StaticResource SurfaceRaised}" CornerRadius="6" Padding="12,3">
              <TextBlock Text="Preview" FontSize="11" />
            </Border>
            <Border x:Name="LastSentChip" Margin="6,0,0,0" BorderBrush="{StaticResource LineStrong}" BorderThickness="1" CornerRadius="6" Padding="12,3"
                    ToolTip="Nothing has been sent yet." Opacity="0.5">
              <TextBlock x:Name="LastSentText" Text="Last sent" FontSize="11" Foreground="{StaticResource Cyan}" />
            </Border>
          </StackPanel>
          <TextBlock Text="Drag widgets onto the strip. Drag to move, Delete or ✕ to remove, ↑/↓ to nudge."
                     Style="{StaticResource Dim}" FontSize="10" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0" />
        </StackPanel>
        <c:StripCanvas x:Name="Strip" IsEditable="True" HorizontalAlignment="Center" />
      </DockPanel>
    </Border>

    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <!-- Device -->
        <Border Style="{StaticResource Card}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="Case LCD strip" Style="{StaticResource CardTitle}" />
              <TextBlock x:Name="DeviceLine" Style="{StaticResource Dim}" Margin="0,3,0,12" />
              <StackPanel Orientation="Horizontal">
                <Border x:Name="DevicePill" Style="{StaticResource Pill}" VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="DeviceDot" Width="7" Height="7" VerticalAlignment="Center" />
                    <TextBlock x:Name="DeviceState" Margin="6,0,0,0" FontSize="11" FontWeight="SemiBold" />
                  </StackPanel>
                </Border>
                <Button x:Name="ConnectButton" Style="{StaticResource BaseButton}" Content="Connect" Margin="10,0,0,0" Padding="14,5" />
              </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <Grid>
                <TextBlock Text="Brightness" FontSize="13" Foreground="{StaticResource TextSecondary}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                  <TextBlock x:Name="BrightnessLabel" Text="Standard" FontSize="11" Foreground="{StaticResource TextFaint}" VerticalAlignment="Center" />
                  <Button x:Name="ApplyBrightnessButton" Style="{StaticResource LinkButton}" Content="Apply" Margin="10,0,0,0"
                          Foreground="{StaticResource Cyan}" ToolTip="Sends one frame carrying the new brightness byte." />
                </StackPanel>
              </Grid>
              <Slider x:Name="BrightnessSlider" Style="{StaticResource FlatSlider}" Minimum="32" Maximum="160" SmallChange="1" LargeChange="8"
                      Margin="0,10,0,0" ToolTip="Brightness byte 0x20-0xA0. Default 0x79. Live frames carry it; Apply sends one now." />
            </StackPanel>
          </Grid>
        </Border>

        <!-- Theme -->
        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
          <StackPanel>
            <TextBlock Text="Theme" Style="{StaticResource CardTitle}" />
            <WrapPanel x:Name="ThemeTiles" Margin="0,12,0,0" />
          </StackPanel>
        </Border>

        <!-- Palette -->
        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
          <StackPanel>
            <Grid>
              <TextBlock Text="Widgets · drag onto the strip" Style="{StaticResource CardTitle}" />
              <TextBlock Text="Double-click adds to the bottom" Style="{StaticResource Dim}" FontSize="11" HorizontalAlignment="Right" />
            </Grid>
            <WrapPanel x:Name="Palette" Margin="0,12,0,0" />
          </StackPanel>
        </Border>

        <!-- Layout / inspector -->
        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition Width="20" />
              <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="On the strip" Style="{StaticResource CardTitle}" />
              <ListBox x:Name="WidgetList" Style="{StaticResource DarkList}" DisplayMemberPath="Summary" Height="170" Margin="0,10,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock x:Name="SelectedTitle" Text="Nothing selected" Style="{StaticResource CardTitle}" />
              <StackPanel x:Name="Inspector" Margin="0,10,0,0">
                <Grid>
                  <TextBlock Text="Height" Style="{StaticResource Dim}" />
                  <TextBlock x:Name="HeightLabel" Style="{StaticResource Dim}" HorizontalAlignment="Right" />
                </Grid>
                <Slider x:Name="HeightSlider" Style="{StaticResource FlatSlider}" Minimum="80" Maximum="600" SmallChange="10"
                        LargeChange="20" TickFrequency="10" IsSnapToTickEnabled="True" Margin="0,6,0,10" />
                <StackPanel x:Name="TextRow">
                  <TextBlock x:Name="TextLabel" Text="Text" Style="{StaticResource Dim}" />
                  <TextBox x:Name="ItemText" Style="{StaticResource DarkTextBox}" Margin="0,6,0,10" />
                </StackPanel>
                <Button x:Name="ChooseImageButton" Style="{StaticResource BaseButton}" Content="Choose image…" Margin="0,0,0,10" />
                <Button x:Name="RemoveButton" Style="{StaticResource BaseButton}" Content="Remove from strip" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                <Button x:Name="ResetButton" Style="{StaticResource BaseButton}" Content="Reset layout" />
                <Button x:Name="SaveButton" Style="{StaticResource BaseButton}" Content="Save layout" Margin="8,0,0,0" />
              </StackPanel>
            </StackPanel>
          </Grid>
        </Border>

        <!-- Updates -->
        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
          <StackPanel>
            <TextBlock Text="Updates" Style="{StaticResource CardTitle}" />
            <Grid Margin="0,14,0,0">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <CheckBox x:Name="LiveToggle" Style="{StaticResource ToggleSwitch}" Content="Live updates" IsChecked="True" />
                <Button x:Name="CadenceButton" Style="{StaticResource BaseButton}" Content="every 2 s" Margin="40,0,0,0" Padding="12,5"
                        ToolTip="Click to cycle 2 / 3 / 5 seconds" />
              </StackPanel>
              <Button x:Name="SendButton" Style="{StaticResource CyanButton}" Content="Send to panel" HorizontalAlignment="Right"
                      ToolTip="Sends one full frame now." />
            </Grid>
            <TextBlock x:Name="UpdatesNote" Text="Preview is 440×1920" Style="{StaticResource Dim}"
                       Foreground="{StaticResource TextFaint}" Margin="0,16,0,0" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>

<Window x:Class="StripView.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:StripView.Views"
        Title="Case LCD" Icon="pack://application:,,,/assets/stripview.ico" Width="1600" Height="1000" MinWidth="1280" MinHeight="800"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}" Foreground="{StaticResource TextPrimary}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        TextOptions.TextFormattingMode="Display">
  <DockPanel>
    <!-- Header -->
    <Grid DockPanel.Dock="Top" Margin="28,18,28,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
        <TextBlock Text="LOCAL / NO CLOUD" Style="{StaticResource Caps}" VerticalAlignment="Center" Margin="0,0,14,0" />
        <Border x:Name="SyncPill" Style="{StaticResource Pill}" BorderBrush="#3A4A1A" Background="#141A0A">
          <StackPanel Orientation="Horizontal">
            <Ellipse x:Name="SyncDot" Width="7" Height="7" Fill="{StaticResource Lime}" VerticalAlignment="Center" />
            <TextBlock x:Name="SyncText" Text="PREVIEW · 2s" Margin="7,0,0,0" FontSize="10" FontWeight="Bold"
                       Foreground="{StaticResource Lime}" VerticalAlignment="Center" />
          </StackPanel>
        </Border>
      </StackPanel>

      <Grid Grid.Row="1" Margin="0,18,0,0">
        <StackPanel Orientation="Horizontal">
          <RadioButton x:Name="TabHome" Style="{StaticResource NavTab}" Content="Home" IsChecked="True" />
          <RadioButton x:Name="TabDesign" Style="{StaticResource NavTab}" Content="Design" />
          <RadioButton x:Name="TabDiag" Style="{StaticResource NavTab}" Content="Diagnostics" />
        </StackPanel>
        <TextBlock Text="DISPLAY / 01" Style="{StaticResource Caps}" HorizontalAlignment="Right" VerticalAlignment="Top" />
        <Border Height="1" Background="{StaticResource Line}" VerticalAlignment="Bottom" />
      </Grid>
    </Grid>

    <!-- Status bar -->
    <Border DockPanel.Dock="Bottom" Background="#0F1013" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="28,7">
      <StackPanel Orientation="Horizontal">
        <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{StaticResource Warn}" VerticalAlignment="Center" />
        <TextBlock x:Name="StatusText" Margin="10,0,0,0" FontSize="12" Foreground="{StaticResource TextSecondary}" />
      </StackPanel>
    </Border>

    <Grid>
      <v:HomeView x:Name="HomePage" />
      <v:DesignView x:Name="DesignPage" Visibility="Collapsed" />
      <v:DiagnosticsView x:Name="DiagPage" Visibility="Collapsed" />
    </Grid>
  </DockPanel>
</Window>
